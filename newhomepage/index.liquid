<script>
  // Hide fares and trip dates that have already passed
  (function () {
    var today = new Date();
    var ymd = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
    document.querySelectorAll("[data-period-end]").forEach(function (el) {
      if (+el.dataset.periodEnd < ymd) el.remove();
    });
    document.querySelectorAll(".next-dates").forEach(function (list) {
      var shown = 0;
      list.querySelectorAll("[data-date]").forEach(function (el) {
        var upcoming = +el.dataset.date.replace(/-/g, "") >= ymd;
        el.hidden = !upcoming || shown >= 3;
        if (upcoming) shown++;
      });
    });
  })();
</script>
