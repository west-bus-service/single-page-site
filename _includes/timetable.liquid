{%- assign tr = t.routes[route.id] -%}
<div class="route-card" style="--route: {{ route.color }}">
  <div class="route-head">
    <h3>{{ tr.name | default: route.name }}</h3>
    <p class="route-service">{{ t.services[route.service] | default: route.service }}</p>
    <p class="route-desc">{{ tr.desc | default: route.description }}</p>
  </div>
  {% unless hideMap %}<div class="route-map" data-route="{{ route.id }}" role="region" aria-label="{{ t.mapOf }} {{ tr.name | default: route.name }}"></div>{% endunless %}
  {% if route.upcomingDates.size > 0 %}
  <p class="next-dates">{{ t.nextTrips }}:
    {% for d in route.upcomingDates %}<span class="date" data-date="{{ d.iso }}"{% if forloop.index > 3 %} hidden{% endif %}>{{ d.iso | remove: "-" | gtfsDate: t.locale }}</span>{% endfor %}
  </p>
  {% endif %}
  <div class="table-wrap">
    <table class="timetable">
      <thead>
        <tr>
          <th scope="col" rowspan="{% if route.hasRowFares %}2{% else %}1{% endif %}">{{ t.town }}</th>
          <th scope="col" rowspan="{% if route.hasRowFares %}2{% else %}1{% endif %}">{{ t.stop }}</th>
          <th scope="col" rowspan="{% if route.hasRowFares %}2{% else %}1{% endif %}">{{ t.to }} {{ route.outTown }}</th>
          {% if route.backLabel != "" %}<th scope="col" rowspan="{% if route.hasRowFares %}2{% else %}1{% endif %}">{{ t.to }} {{ route.backTown }}</th>{% endif %}
          {% if route.hasRowFares %}
          {% for p in periods %}<th scope="colgroup" colspan="2" class="fare" data-period-end="{{ p.end }}">{{ t.faresTo }}<br><span class="period">{% if p.kind == "until" %}{{ t.until }} {{ p.end | gtfsDate: t.locale }}{% else %}{{ t.from }} {{ p.start | gtfsDate: t.locale }}{% endif %}</span></th>{% endfor %}
          {% endif %}
        </tr>
        {% if route.hasRowFares %}
        <tr>
          {% for p in periods %}<th scope="col" class="fare" data-period-end="{{ p.end }}">{{ t.oneWayShort }}</th><th scope="col" class="fare" data-period-end="{{ p.end }}">{{ t.roundTripShort }}</th>{% endfor %}
        </tr>
        {% endif %}
      </thead>
      <tbody>
        {% for row in route.rows %}
        <tr>
          <th scope="row">{% if row.flag %}<img class="flag" src="../flag.svg" alt="{{ t.flagStop }}" width="20" height="16"> {% endif %}{{ row.town }}</th>
          <td>{{ row.location }}</td>
          <td class="time">{{ row.out }}</td>
          {% if route.backLabel != "" %}<td class="time">{{ row.back }}</td>{% endif %}
          {% if route.hasRowFares %}
          {% for p in periods %}
          {% assign f = row.fares[p.id] %}
          <td class="fare" data-period-end="{{ p.end }}">{{ f.oneWay }}</td><td class="fare" data-period-end="{{ p.end }}">{{ f.roundTrip }}</td>
          {% endfor %}
          {% endif %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if route.fares %}
  <ul class="fare-list">
    {% for p in periods %}
    {% assign f = route.fares[p.id] %}
    <li data-period-end="{{ p.end }}"><strong>{% if p.kind == "until" %}{{ t.until }} {{ p.end | gtfsDate: t.locale }}{% else %}{{ t.from }} {{ p.start | gtfsDate: t.locale }}{% endif %}:</strong>
      {% if f.oneWay %}{{ t.oneWay }} {{ f.oneWay }}{% endif %}{% if f.oneWay and f.roundTrip %}, {% endif %}{% if f.roundTrip %}{{ t.roundTrip }} {{ f.roundTrip }}{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if route.hasRowFares %}<p class="legend-note"><img class="flag" src="../flag.svg" alt="" width="20" height="16"> {{ t.flagLegend }}</p>{% endif %}
</div>
